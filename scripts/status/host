#!/usr/bin/env bash
# USAGE: host
# DESCRIPTION: Print the short hostname, or the LSF job id inside a batch job, as a colored tmux status segment.

host="$(hostname -s)"
color=colour10
if [[ -n "$LSB_BATCH_JID" ]]; then
	color=colour11
	host="$LSB_BATCH_JID"
	# TODO: time_left=$(bjobs -noheader -o time_left $job)
elif [[ "$host" =~ ^s110 ]]; then
	color=colour9
fi
echo "#[fg=$color][$host]#[fg=default]"

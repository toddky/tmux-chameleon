#!/usr/bin/env bash
# USAGE: battery
# DESCRIPTION: Print the battery percentage as a colored tmux status segment; prints nothing without a battery.

# ==============================================================================
# READ BATTERY
# ==============================================================================
percent=''
charging=0
if command -v pmset &>/dev/null; then
	battery_info="$(pmset -g batt)"
	percent="$(grep -o '[0-9]\{1,3\}%' <<<"$battery_info" | tr -d '%')"
	if [[ "$battery_info" == *"AC Power"* ]]; then
		charging=1
	fi
else
	for supply_dir in /sys/class/power_supply/*; do
		[[ "$(cat "$supply_dir/type" 2>/dev/null)" == Battery ]] || continue
		# Wireless mice and keyboards report scope=Device; only the laptop's own battery matters.
		[[ "$(cat "$supply_dir/scope" 2>/dev/null)" != Device ]] || continue
		percent="$(cat "$supply_dir/capacity" 2>/dev/null)"
		case "$(cat "$supply_dir/status" 2>/dev/null)" in
			Charging|Full|"Not charging") charging=1;;
		esac
		break
	done
fi
[[ -n "$percent" ]] || exit 0


# ==============================================================================
# PRINT BATTERY
# ==============================================================================
color=10
if ((percent < 20)); then
	color=9
elif ((percent < 50)); then
	color=11
fi
plugged=''
if ((charging)); then
	plugged='+'
fi
echo "#[fg=colour$color][$plugged$percent%]#[fg=default]"
